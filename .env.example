# Origin of the main TrustBrig app. Footer links (About, Contact, Privacy,
# Terms, Cookies) are prefixed with this. Leave empty for same-origin paths.
NEXT_PUBLIC_APP_URL=

# TrustBrig backend GraphQL endpoint. Server-side only — never exposed to the
# browser, which talks to this app's own /api/subscribe route.
# Port must match APP_PORT in the backend's .env (3001 by default). Prefer
# 127.0.0.1 over localhost so Node cannot resolve it to IPv6 and miss the server.
BACKEND_GRAPHQL_URL=http://127.0.0.1:3001/graphql
